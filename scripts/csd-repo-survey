#!/usr/bin/env python3
"""Survey a repository into the evidence a goal-writer needs.

WHY THIS EXISTS. Every goal that failed here failed for want of evidence, not for
want of thought: one specified schema validation the function does not perform;
one said "add tests for untested branches" without saying which; one omitted that
a fixture needs a `trust` block two calls down. All three were answerable by
reading the source for five minutes, and none of them were.

So this reads the source and reports what is THERE. It proposes nothing and
judges nothing -- a survey that guesses at intent produces goals as wrong as the
ones written from memory, only faster.

What it reports, per module:
  - public functions and classes, with the ones no test names
  - fixtures the code reaches for (subscripted config keys), which is how the
    `catalog["trust"]` trap was invisible
  - TODO/FIXME/XXX markers, with file and line
  - declared-but-unused module constants, which are usually a missing check
  - CI workflows, and whether their runs-on labels can ever match a runner
  - docs that mention a symbol that no longer exists

Usage:
    csd-repo-survey <path> [--json]
"""

from __future__ import annotations

import argparse
import ast
import contextlib
import json
import pathlib
import re
import sys

SKIP_DIRS = {
    ".git",
    "__pycache__",
    ".venv",
    "venv",
    "node_modules",
    "target",
    ".mypy_cache",
    ".pytest_cache",
    "dist",
    "build",
}


def py_files(root: pathlib.Path):
    for p in sorted(root.rglob("*.py")):
        if any(part in SKIP_DIRS for part in p.parts):
            continue
        yield p


def module_facts(path: pathlib.Path, root: pathlib.Path) -> dict:
    try:
        src = path.read_text(encoding="utf-8", errors="replace")
        tree = ast.parse(src)
    except Exception as e:
        return {"path": str(path.relative_to(root)), "error": type(e).__name__}

    funcs, classes, consts = [], [], []
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and not node.name.startswith("_"):
            funcs.append(
                {
                    "name": node.name,
                    "line": node.lineno,
                    "args": [a.arg for a in node.args.args],
                    "doc": bool(ast.get_docstring(node)),
                }
            )
        elif isinstance(node, ast.ClassDef):
            classes.append(
                {
                    "name": node.name,
                    "line": node.lineno,
                    "methods": [
                        n.name
                        for n in node.body
                        if isinstance(n, ast.FunctionDef) and not n.name.startswith("_")
                    ],
                }
            )
        elif isinstance(node, ast.Assign):
            for t_ in node.targets:
                if isinstance(t_, ast.Name) and t_.id.isupper():
                    consts.append({"name": t_.id, "line": node.lineno})

    # Which module-level constants are never read again? A constant defined and
    # never used is usually a check somebody meant to write. CATALOG_SCHEMA was
    # exactly that, and it became a real goal.
    body_after = src
    unused = [
        c["name"]
        for c in consts
        if len(re.findall(rf"\b{re.escape(c['name'])}\b", body_after)) <= 1
    ]

    # Keys the code subscripts out of a dict argument. These are the fixture
    # requirements that are invisible until a test raises KeyError.
    required_keys = sorted(set(re.findall(r"\b\w+\[[\"']([a-z_]+)[\"']\]", src)))

    markers = [
        {"line": i, "text": ln.strip()[:100]}
        for i, ln in enumerate(src.splitlines(), 1)
        if re.search(r"\b(TODO|FIXME|XXX|HACK)\b", ln)
    ]

    return {
        "path": str(path.relative_to(root)),
        "functions": funcs,
        "classes": classes,
        "constants": consts,
        "unused_constants": unused,
        "subscripted_keys": required_keys,
        "markers": markers,
        "lines": len(src.splitlines()),
    }


def survey(root: pathlib.Path) -> dict:
    mods = [module_facts(p, root) for p in py_files(root)]
    src_mods = [
        m
        for m in mods
        if "tests/" not in m["path"]
        and not pathlib.Path(m["path"]).name.startswith("test_")
    ]
    test_mods = [m for m in mods if m not in src_mods]

    test_text = ""
    for m in test_mods:
        with contextlib.suppress(Exception):
            test_text += (root / m["path"]).read_text(encoding="utf-8", errors="replace")

    # A function no test file so much as names. Not proof it is untested, but it
    # is the honest, cheap signal -- and it is what "which branches are untested"
    # was asking for.
    untested = []
    for m in src_mods:
        for f in m.get("functions", []):
            if not re.search(rf"\b{re.escape(f['name'])}\b", test_text):
                untested.append(
                    {
                        "module": m["path"],
                        "name": f["name"],
                        "line": f["line"],
                        "documented": f["doc"],
                    }
                )

    workflows = []
    for d in (".github/workflows", ".forgejo/workflows"):
        wd = root / d
        if not wd.is_dir():
            continue
        for w in sorted(wd.glob("*.y*ml")):
            body = w.read_text(encoding="utf-8", errors="replace")
            labels = re.findall(r"runs-on:\s*\[?([^\]\n]+)\]?", body)
            workflows.append(
                {
                    "path": str(w.relative_to(root)),
                    "runs_on": [s.strip().strip("'\"") for s in labels],
                }
            )

    return {
        "root": str(root),
        "modules": len(src_mods),
        "test_modules": len(test_mods),
        "functions": sum(len(m.get("functions", [])) for m in src_mods),
        "untested_functions": untested,
        "unused_constants": [
            {"module": m["path"], "names": m["unused_constants"]}
            for m in src_mods
            if m.get("unused_constants")
        ],
        "fixture_keys": {
            m["path"]: m["subscripted_keys"]
            for m in src_mods
            if m.get("subscripted_keys")
        },
        "markers": [
            {"module": m["path"], **k} for m in mods for k in m.get("markers", [])
        ],
        "workflows": workflows,
        "detail": src_mods,
    }


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("path")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    root = pathlib.Path(a.path).resolve()
    if not root.is_dir():
        print(f"not a directory: {root}", file=sys.stderr)
        return 2
    s = survey(root)

    if a.json:
        print(json.dumps(s, indent=2))
        return 0

    print(
        f"  {root.name}: {s['modules']} module(s), {s['functions']} public "
        f"function(s), {s['test_modules']} test module(s)\n"
    )

    print(f"  --- functions no test names ({len(s['untested_functions'])}) ---")
    for f in s["untested_functions"][:20]:
        doc = "" if f["documented"] else "  (undocumented)"
        print(f"    {f['module']}:{f['line']}  {f['name']}(){doc}")

    if s["unused_constants"]:
        print("\n  --- constants defined and never read (often a missing check) ---")
        for u in s["unused_constants"]:
            print(f"    {u['module']}: {', '.join(u['names'])}")

    if s["fixture_keys"]:
        print("\n  --- keys the code subscripts (a test fixture MUST carry these) ---")
        for mod, keys in s["fixture_keys"].items():
            print(f"    {mod}: {', '.join(keys[:12])}")

    if s["markers"]:
        print(f"\n  --- TODO/FIXME markers ({len(s['markers'])}) ---")
        for m in s["markers"][:10]:
            print(f"    {m['module']}:{m['line']}  {m['text']}")

    if s["workflows"]:
        print("\n  --- workflows and the labels they demand ---")
        for w in s["workflows"]:
            for r in w["runs_on"]:
                print(f"    {w['path']}: {r}")

    print(
        "\n  This is evidence, not goals. Turn it into goals with docs/GOAL-DISCOVERY.md."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
