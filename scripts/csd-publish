#!/usr/bin/env python3
"""Build a sanitised publication tree. Never flips visibility.

WHY. The audit of this repo came back DO-NOT-PUSH, and the reason was not a
credential -- there isn't one. It was that the tree contains a verified
penetration test of a live network with file:line detail, and a 4,000-line
sandbox document full of live probe results. A squashed commit does NOT remove
those: a squash preserves the tree byte for byte, so flattening is cosmetic here.

WHAT IT DOES:
  1. Copies the tree to a publication directory.
  2. WITHHOLDS files that are process evidence rather than product -- a threat
     model naming exploitable paths is useful to us and to an attacker, and
     useless to a reader who wants the design.
  3. REWRITES the fleet's real identifiers to documentation-reserved
     placeholders: RFC 5737 addresses, RFC 2606 domains, generic hostnames.
  4. VERIFIES the result: it greps the output for every original identifier and
     refuses to finish if one survived.

That last step is the point. A sanitiser nobody checks is a sanitiser that
missed something -- and here "missed something" means published it.

WHAT IT WILL NOT DO. It does not push, tag, or change visibility. Those stay
manual, because the failure mode is unrecoverable: published content is indexed
and cached, and deleting the repository afterwards does not retract it.

Usage:
    csd-publish <src> <dest> [--check-only]
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
from pathlib import Path


# THE SUBSTITUTION TABLE IS FLEET DATA, NOT CODE.
#
# It used to be literal in this file -- and so this script became the only thing
# its own verifier still flagged, because a tool that removes identifiers has to
# NAME them. It could not sanitise itself, which meant the one file that proves
# the tree is clean was the file making it dirty.
#
# The table now lives in the gitignored private config beside the real
# addresses, which is where fleet-specific data belongs anyway. Committed, this
# script contains no identifier at all; without the private config it withholds
# the evidence directories and rewrites nothing, and SAYS SO rather than
# reporting a clean run it did not perform.
def load_rules() -> tuple[list, list, list, dict, list]:
    """Substitutions, withheld paths, forbidden patterns, redactions, from
    the private config -- plus the RAW substitution rule dicts.

    The raw rules travel separately from the `(pattern, replacement)` tuples
    `sanitise()` applies because `find_collisions()` needs a field
    `sanitise()` does not: `shared_replacement`. Collapsing to tuples first
    and recovering the flag later would mean re-reading the same config a
    second time, which is exactly the kind of duplicated parsing that drifts.
    """
    cfg = {}
    for candidate in (
        Path(os.environ.get("AUTODEV_FLEET_CONFIG", ""))
        if os.environ.get("AUTODEV_FLEET_CONFIG")
        else None,
        Path(__file__).resolve().parents[1] / "config" / "fleet.json",
    ):
        if candidate and candidate.is_file():
            try:
                cfg = json.loads(candidate.read_text(encoding="utf-8"))
                break
            except (OSError, ValueError):
                continue
    pub = cfg.get("publish") or {}
    redactions = pub.get("redact_sections", {})
    rules = pub.get("substitutions", [])
    subs = [(r["pattern"], r["replacement"]) for r in rules]
    withhold = pub.get(
        "withhold",
        [
            # Safe even with no private config: these are process evidence by path.
            "docs/evidence",
            "docs/operations",
            "docs/cohort",
        ],
    )
    forbidden = pub.get("forbidden", [])
    return subs, withhold, forbidden, redactions, rules


SUBSTITUTIONS, WITHHOLD, FORBIDDEN, REDACTIONS, SUBSTITUTION_RULES = load_rules()

# Suffixes that are DEFINITELY binary. Everything else is tried as UTF-8 text
# and sanitised if it decodes, which is the safe direction: a new kind of text
# file is covered the day it appears rather than the day someone remembers to
# add it here.
#
# It used to be an allow-list of text suffixes, and that failed the first time
# it was tested. Extracting the lab console's page from a .py file into
# web/lab-console.html moved 44 KB of text out of a covered extension and into
# an uncovered one; three real hostnames survived into the publication tree and
# only the verifier caught them.
BINARY_SUFFIXES = {
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".bmp",
    ".tiff",
    ".pdf",
    ".zip",
    ".gz",
    ".bz2",
    ".xz",
    ".zst",
    ".tar",
    ".whl",
    ".so",
    ".dylib",
    ".dll",
    ".o",
    ".a",
    ".bin",
    ".pyc",
    ".woff",
    ".woff2",
    ".ttf",
    ".otf",
    ".eot",
    ".mp3",
    ".mp4",
    ".wav",
    ".ogg",
    ".webm",
    ".safetensors",
    ".pt",
    ".onnx",
}


def redact_sections(text: str, rules: list) -> str:
    """Drop whole sections by heading, rather than editing lines.

    A 4,000-line security document cannot be made safe by find-and-replace: the
    risk is not a string, it is a SECTION -- a table of live probe results, a
    disposition list of real findings. Substituting identifiers inside those
    leaves the shape of the vulnerability intact and the reader one search away
    from the original.

    So the risky spans are removed entirely and replaced with a line saying so.
    Structural, verifiable, and it cannot half-succeed the way a regex over
    4,000 lines can -- which it did, twice, on this repository's first attempt.
    """
    for rule in rules:
        start, until = rule.get("from"), rule.get("until")
        note = rule.get("note", "withheld")
        lines, out, dropping = text.splitlines(keepends=True), [], False
        for ln in lines:
            if not dropping and ln.startswith(start):
                dropping = True
                out.append(f"{until.split()[0]} [redacted]\n\n> {note}\n\n")
                continue
            if dropping and until and ln.startswith(until):
                dropping = False
            if not dropping:
                out.append(ln)
        text = "".join(out)
    return text


def sanitise(text: str, seen: dict | None = None) -> str:
    """Apply the private substitution table. With none loaded, a no-op.

    `seen`, when given, accumulates what was ACTUALLY MATCHED, as
    `{replacement: {matched_text: {pattern, ...}}}`, for `merged_identifiers()`
    below. Recorded here because this is the only place that knows it: a
    pattern is a regex, and what it matched is not recoverable from the rule.
    """
    for pat, rep in SUBSTITUTIONS:
        if seen is None:
            text = re.sub(pat, rep, text)
            continue

        def _record(m: re.Match, _pat: str = pat, _rep: str = rep) -> str:
            seen.setdefault(_rep, {}).setdefault(m.group(0), set()).add(_pat)
            return _rep

        text = re.sub(pat, _record, text)
    return text


def merged_identifiers(seen: dict, rules: list) -> list[tuple[str, list[str]]]:
    """Replacements that two or more DISTINCT original strings actually became.

    WHY THIS EXISTS ALONGSIDE find_collisions. That one reads the TABLE, which
    is the right place to fail fast -- before a byte is copied -- and it cannot
    see the case where ONE rule merges two originals by itself. Patterns are
    regexes fed to `re.sub`, so a single unmarked rule `host-gpu-[ab]` mapping
    to one placeholder collapses two hosts with no second table entry to group
    against. Measured: that table publishes `203.0.113.99 and 203.0.113.99`
    from two distinct hosts, exits 0, and prints "verified: no original
    identifier survives" -- because none did, they merged, which the verifier
    has no vocabulary for.

    So this checks the OUTPUT instead of the config, which is the discipline
    docs/LESSONS.md #5 states as "before trusting a check, ask what it looked
    at". It costs one extra bookkeeping dict over text already being read.

    The exemption is the same one and is applied the same way: a replacement is
    excused only when EVERY rule that reached it carries `shared_replacement`.
    `HOST-A` and `host-a` collapsing onto one hostname is correct and marked;
    an unmarked rule joining them is the defect, whether it arrived as a second
    row or as an alternation inside the first.
    """
    marked = {
        r.get("pattern")
        for r in rules
        if r.get("shared_replacement") and r.get("pattern") is not None
    }
    out = []
    for replacement, matches in seen.items():
        if len(matches) < 2:
            continue
        contributing: set[str] = set()
        for pats in matches.values():
            contributing |= pats
        if contributing and contributing <= marked:
            continue
        out.append((replacement, sorted(matches)))
    return sorted(out)


def find_collisions(rules: list) -> list[tuple[str, list[tuple[str, bool]]]]:
    """Substitution rules whose DIFFERENT patterns land on the SAME replacement.

    WHY THIS MATTERS. The verifier at the bottom of `main` proves that no
    ORIGINAL identifier survived. It says nothing about whether two originals
    survived as the SAME thing. That gap already corrupted the published tree
    twice from one root cause: two real GPU host addresses were both rewritten
    to 203.0.113.99. `scripts/csd-lab-console` merged into
    `{HOST_GPU_B_IP, "203.0.113.99", "203.0.113.99"}` -- syntactically a
    three-element set, actually two, so the authorization check it guards
    silently stopped excluding one of the two hosts it named. Nothing failed
    loudly: the set built without error, the script ran, and the exclusion
    was just quietly short by one address. A verifier that only checks "did
    an original leak" cannot catch this, because nothing original leaked --
    two originals leaked as INDISTINGUISHABLE, which is worse, because the
    reader has no way to know a merge happened at all.

    `shared_replacement: true` exempts a REPLACEMENT, not a RULE -- and only
    when EVERY rule that reaches that replacement carries it. This function
    used to skip marked rules before grouping, which meant a marked rule left
    NO TRACE for anything else to collide with: `HOST-A` / `host-a`, marked
    correctly as one hostname's case variants, made an unmarked `gpu-c`
    landing on that same replacement six months later look ALONE in its
    group -- one pattern, not a collision, passed silently. That is the exact
    corruption this guard exists to catch, now hiding behind a guard that
    reports clean for it. A marked rule sharing its replacement with an
    unmarked one is not "case variants collapsing"; it is one reviewed claim
    with one unreviewed collision riding along beside it, and the unreviewed
    one is what the flag was never asked about. So every rule reaching a
    replacement is grouped FIRST, marked and unmarked alike, and the group
    clears ONLY when every member of it is marked -- matching the stub
    audit's `INTENTIONAL` marker and the goal-claims escape hatch elsewhere in
    this repo, where an unmarked instance gets no benefit of the doubt even
    when a marked one sits right next to it.

    Returns one `(replacement, [(pattern, marked), ...])` entry per
    replacement reached by two or more distinct patterns, UNLESS every one of
    those patterns' rules is marked `shared_replacement`. `marked` travels
    with each pattern so the caller can report exactly which pattern in the
    group is the one that is NOT covered by the exemption. Patterns sorted
    for a stable, diffable message. Rules missing a `pattern` or
    `replacement` are not this function's problem -- `sanitise()` will raise
    on those via `SUBSTITUTIONS` the same way it always has -- so they are
    skipped here rather than duplicating that failure with a different
    message.
    """
    by_replacement: dict[str, dict[str, bool]] = {}
    for rule in rules:
        pattern, replacement = rule.get("pattern"), rule.get("replacement")
        if pattern is None or replacement is None:
            continue
        marks = by_replacement.setdefault(replacement, {})
        # A pattern repeated across rules is exempt only if EVERY occurrence
        # of it is marked -- `or` alone would let one marked duplicate cover
        # an unmarked one for the same exact pattern. `.get(pattern, True)`
        # makes the first sighting of a pattern just adopt its own mark.
        marks[pattern] = marks.get(pattern, True) and bool(rule.get("shared_replacement"))
    return sorted(
        (replacement, sorted(marks.items()))
        for replacement, marks in by_replacement.items()
        if len(marks) > 1 and not all(marks.values())
    )


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("src")
    ap.add_argument("dest")
    ap.add_argument("--check-only", action="store_true")
    a = ap.parse_args()

    # Checked before anything touches a filesystem. A colliding table is
    # broken regardless of what src/dest happen to be, and fail-closed means
    # refusing before a single file is copied, not after.
    collisions = find_collisions(SUBSTITUTION_RULES)
    if collisions:
        print("\n  SANITISER FAILED — substitution table has collisions:")
        for replacement, patterns in collisions:
            # Marked entries are labelled so the unmarked one -- the pattern
            # that actually broke the group -- is the one that stands out.
            named = ", ".join(
                f"{p!r} (shared_replacement)" if marked else repr(p)
                for p, marked in patterns
            )
            print(f"    {named} -> {replacement!r}")
        print(
            "\n  Two different originals would become the SAME thing in the "
            "published tree. Mark a genuine case-variant collapse with "
            '"shared_replacement": true on that rule; give every other '
            "pattern its own replacement. Nothing was published."
        )
        return 1

    src, dest = Path(a.src).resolve(), Path(a.dest).resolve()
    # .git is a FILE in a worktree, not a directory -- checking is_dir() refused
    # to run against the tree this repo is actually developed in.
    if not (src / ".git").exists():
        print(json.dumps({"ok": False, "error": f"{src} is not a git repo"}))
        return 2

    r = subprocess.run(
        ["git", "ls-files"], cwd=str(src), capture_output=True, text=True, timeout=120
    )
    files = [f for f in r.stdout.split() if f]

    withheld, copied = [], []
    matched: dict = {}
    if not a.check_only:
        if dest.exists():
            shutil.rmtree(dest)
        dest.mkdir(parents=True)

    for rel in files:
        if any(rel == w or rel.startswith(w + "/") for w in WITHHOLD):
            withheld.append(rel)
            continue
        copied.append(rel)
        if a.check_only:
            continue
        s, d = src / rel, dest / rel
        d.parent.mkdir(parents=True, exist_ok=True)
        if s.suffix.lower() not in BINARY_SUFFIXES:
            try:
                body = s.read_text(encoding="utf-8")
                if rel in REDACTIONS:
                    body = redact_sections(body, REDACTIONS[rel])
                d.write_text(sanitise(body, matched), encoding="utf-8")
                d.chmod(s.stat().st_mode & 0o777)
                continue
            except UnicodeDecodeError:
                pass
        shutil.copy2(s, d)

    print(f"  {len(copied)} file(s) published, {len(withheld)} withheld")
    for w in withheld:
        print(f"    withheld  {w}")

    if a.check_only:
        return 0

    # MERGE CHECK, before the leak check, because the two failures are
    # different and the second cannot see the first. `leaked` asks whether an
    # original SURVIVED; this asks whether two originals arrived as the same
    # string. Nothing original survives a merge, so the verifier below reports
    # success on exactly the corruption this repository has already shipped
    # three times.
    merged = merged_identifiers(matched, SUBSTITUTION_RULES)
    if merged:
        print(f"\n  SANITISER FAILED — {len(merged)} replacement(s) merged:")
        for replacement, originals in merged:
            print(f"    {', '.join(repr(o) for o in originals)} -> {replacement!r}")
        print(
            "\n  Two different originals became the SAME string in the "
            "published tree. Nothing original leaked, so the verifier below "
            "would have passed this. Give each original its own replacement, "
            'or mark EVERY rule that reaches one with "shared_replacement": '
            "true if the collapse is deliberate."
            "\n  The publication tree is NOT safe. Nothing was pushed."
        )
        return 1

    # VERIFY. A sanitiser nobody checks is one that missed something, and here
    # "missed something" means published it.
    leaked: list[str] = []
    for p in sorted(dest.rglob("*")):
        if not p.is_file():
            continue
        try:
            body = p.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        for pat in FORBIDDEN:
            for m in re.finditer(pat, body, re.I):
                leaked.append(f"{p.relative_to(dest)}: {m.group(0)}")
                break
    if leaked:
        print(f"\n  SANITISER FAILED — {len(leaked)} identifier(s) survived:")
        for line in leaked[:25]:
            print(f"    {line}")
        print("\n  The publication tree is NOT safe. Nothing was pushed.")
        return 1

    print("\n  verified: no original identifier survives in the published tree")
    print(
        "  NOT pushed and NOT made public — those stay manual, because "
        "publishing cannot be undone."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
