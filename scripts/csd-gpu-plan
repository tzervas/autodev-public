#!/usr/bin/env python3
"""Observe CSD_GPU_PLAN JSON. No SSH. No host/GPU placement (G6).

Reads the plan file, re-writes it unchanged when valid, prints JSON.
Fails closed if the file is missing, unreadable, or not a JSON object
with the required host keys. Local nvidia-smi refresh is optional and
never reaches another host.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path
from typing import Any

OUT = Path(os.environ.get("CSD_GPU_PLAN", "/fleet-data/cabal/gpu-plan.json"))
REQUIRED = ("host-a", "host-gpu-b")


def _load_plan(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise SystemExit(f"csd-gpu-plan: missing plan file {path} (fail closed)")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"csd-gpu-plan: invalid plan file {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit(f"csd-gpu-plan: plan root must be object: {path}")
    missing = [k for k in REQUIRED if k not in data]
    if missing:
        raise SystemExit(
            f"csd-gpu-plan: plan missing keys {missing}: {path} (fail closed)"
        )
    return data


def _smi_local() -> dict[str, Any] | None:
    """Optional local-only refresh. Never SSH."""
    try:
        p = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=name,memory.used,memory.free,memory.total",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=8,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    parts = [x.strip() for x in (p.stdout or "").split(",")]
    if len(parts) < 4:
        return None
    try:
        used, free, total = (int(float(parts[i])) for i in (1, 2, 3))
    except ValueError:
        return None
    return {
        "name": parts[0],
        "used_mib": used,
        "free_mib": free,
        "total_mib": total,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--refresh-local",
        action="store_true",
        help="merge local nvidia-smi into host-a; never SSH",
    )
    args = parser.parse_args(argv)
    plan = _load_plan(OUT)
    if args.refresh_local:
        local = _smi_local()
        if local is None:
            raise SystemExit("csd-gpu-plan: local nvidia-smi failed (fail closed)")
        node = plan.get("host-a")
        if not isinstance(node, dict):
            node = {}
        node.update(local)
        plan["host-a"] = node
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(plan, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
