NAMESPACE = uuid.UUID("6f2a2c9e-1b1d-4e8a-9c9b-2f6b1c9a3d10")  # fixed, arbitrary


def chunk_body(body: str, min_len: int = 80, max_len: int = 2500):
    """Heading-bounded chunker (same shape as the vault indexer's ``chunks()``)."""
    parts = re.split(r"(?m)^(#{1,6} .+)$", body)
    cur_h = ""
    buf = parts[0] if parts else ""
    i = 1
    while i < len(parts):
        heading = parts[i]
        rest = parts[i + 1] if i + 1 < len(parts) else ""
        piece = (heading + "\n" + rest).strip()
        if len(buf) + len(piece) > max_len and len(buf) >= min_len:
            yield cur_h, buf.strip()
            buf = piece
            cur_h = heading.lstrip("# ").strip()
        else:
            buf = (buf + "\n\n" + piece).strip()
            if heading.startswith("#"):
                cur_h = heading.lstrip("# ").strip()
        i += 2
    if buf.strip():
        yield cur_h, buf.strip()


def cmd_chunk(args: argparse.Namespace) -> int:
    out_path = Path(args.out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    n_files = 0
    n_chunks = 0
    missing: list[str] = []
    with out_path.open("w", encoding="utf-8") as out:
        for repo, rel in MANIFEST:
            fp = REPO_ROOT / repo / rel
            if not fp.is_file():
                missing.append(f"{repo}/{rel}")
                continue
            text = fp.read_text(encoding="utf-8", errors="replace")
            n_files += 1
            for idx, (heading, body) in enumerate(chunk_body(text)):
                if len(body.strip()) < 40:
                    continue
                content_hash = hashlib.sha256(body.encode("utf-8")).hexdigest()
                point_id = str(
                    uuid.uuid5(NAMESPACE, f"{repo}:{rel}:{idx}:{content_hash}")
                )
                rec = {
                    "id": point_id,
                    "repo": repo,
                    "path": rel,
                    "heading": heading or Path(rel).stem,
                    "chunk_index": idx,
                    "content_hash": content_hash,
                    "text": body,
                }
                out.write(json.dumps(rec, ensure_ascii=False) + "\n")
                n_chunks += 1
    print(
        f"chunk: manifest={len(MANIFEST)} files_ok={n_files} "
        f"files_missing={len(missing)} "
        f"chunks={n_chunks} -> {out_path}",
        file=sys.stderr,
    )
    for m in missing:
        print(f"  MISSING (manifest drift, not embedded): {m}", file=sys.stderr)
    receipt = {
        "manifest_count": len(MANIFEST),
        "files_embedded": n_files,
        "files_missing": missing,
        "chunks": n_chunks,
        "collection": COLLECTION,
        "embed_model": EMBED_MODEL,
        "embed_revision": EMBED_REVISION,
        "embed_dim": EMBED_DIM,
    }
    receipt_path = out_path.with_suffix(".receipt.json")
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
    print(f"chunk: receipt -> {receipt_path}", file=sys.stderr)
    return 0 if not missing else 1


def cmd_embed(args: argparse.Namespace) -> int:
    import torch
    from qdrant_client import QdrantClient
    from qdrant_client.models import (
        Distance,
        FieldCondition,
        Filter,
        FilterSelector,
        MatchAny,
        PayloadSchemaType,
        PointStruct,
    )
    from transformers import AutoModel, AutoTokenizer

    if not torch.cuda.is_available():
        raise SystemExit("CUDA is required to embed autodev-kb; refusing CPU.")

    dtype = torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16
    dev = torch.device("cuda")
    print(
        f"embedder={EMBED_MODEL}@{EMBED_REVISION[:12]} "
        f"device={torch.cuda.get_device_name(0)} "
        f"dtype={dtype}",
        file=sys.stderr,
    )
    tok = AutoTokenizer.from_pretrained(
        EMBED_MODEL, revision=EMBED_REVISION, padding_side="left"
    )
    model = AutoModel.from_pretrained(
        EMBED_MODEL, revision=EMBED_REVISION, dtype=dtype, attn_implementation="sdpa"
    ).to(dev)
    model.eval()

    def embed(texts: list[str]) -> list[list[float]]:
        enc = tok(
            texts, padding=True, truncation=True, max_length=1024, return_tensors="pt"
        )
        enc = {k: v.to(dev) for k, v in enc.items()}
        with torch.inference_mode():
            last = model(**enc).last_hidden_state
            mask = enc["attention_mask"]
            left_padding = mask[:, -1].sum() == mask.shape[0]
            if left_padding:
                pooled = last[:, -1]
            else:
                seq_len = mask.sum(dim=1) - 1
                pooled = last[torch.arange(last.shape[0], device=dev), seq_len]
            vec = torch.nn.functional.normalize(pooled.float(), p=2, dim=1)
        return vec.cpu().numpy().tolist()

    dim = len(embed(["warmup"])[0])
    if dim != EMBED_DIM:
        raise SystemExit(f"embedder dim={dim} != pinned {EMBED_DIM}; refusing to upsert")

    client = QdrantClient(url=args.qdrant, timeout=30)
    names = [c.name for c in client.get_collections().collections]
    if args.collection not in names:
        raise SystemExit(
            f"collection {args.collection} does not exist; create it first "
            f"(size={EMBED_DIM}, distance=Cosine) — never auto-create here."
        )
    info = client.get_collection(args.collection)
    size = info.config.params.vectors.size  # type: ignore[union-attr]
    dist = info.config.params.vectors.distance  # type: ignore[union-attr]
    if size != EMBED_DIM or dist != Distance.COSINE:
        raise SystemExit(
            f"collection {args.collection} is size={size} distance={dist}; "
            f"expected {EMBED_DIM}/Cosine. Refusing to mutate an existing collection's "
            "dimension or metric."
        )
    for field in ("repo", "path", "content_hash"):
        try:
            client.create_payload_index(
                args.collection, field, field_schema=PayloadSchemaType.KEYWORD
            )
        except Exception as exc:
            print(f"payload index {field}: {exc}", file=sys.stderr)

    recs = [
        json.loads(line)
        for line in Path(args.in_path).read_text(encoding="utf-8").splitlines()
        if line.strip()
    ]
    paths = sorted({r["path"] for r in recs})
    # Idempotent re-run: drop this manifest's prior points before upserting fresh ones,
    # same shape as the vault indexer's delete_paths().
    if not args.no_delete_first:
        client.delete(
            collection_name=args.collection,
            points_selector=FilterSelector(
                filter=Filter(
                    must=[FieldCondition(key="path", match=MatchAny(any=paths))]
                )
            ),
        )
        print(f"deleted prior points for {len(paths)} paths", file=sys.stderr)

    batch = 8
    upserted = 0
    for i in range(0, len(recs), batch):
        group = recs[i : i + batch]
        vecs = embed([r["text"] for r in group])
        points = [
            PointStruct(
                id=r["id"],
                vector=vecs[j],
                payload={
                    "repo": r["repo"],
                    "path": r["path"],
                    "vault_path": r["path"],
                    "heading": r["heading"],
                    "chunk_index": r["chunk_index"],
                    "content_hash": r["content_hash"],
                    "text": r["text"],
                    "source": "curated-from-source",
                    "curated_at": args.curated_at,
                },
            )
            for j, r in enumerate(group)
        ]
        client.upsert(collection_name=args.collection, points=points, wait=True)
        upserted += len(points)
        print(f"upserted {upserted}/{len(recs)}", file=sys.stderr)

    print(f"embed: done. collection={args.collection} points={upserted}", file=sys.stderr)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_chunk = sub.add_parser(
        "chunk", help="Chunk MANIFEST into a JSONL (no CUDA needed)."
    )
    p_chunk.add_argument("--out", required=True)
    p_chunk.set_defaults(func=cmd_chunk)

    p_embed = sub.add_parser(
        "embed", help="Embed a chunk JSONL and upsert into Qdrant (CUDA required)."
    )
    p_embed.add_argument("--in", dest="in_path", required=True)
    p_embed.add_argument("--qdrant", default="http://127.0.0.1:6333")
    p_embed.add_argument("--collection", default=COLLECTION)
    p_embed.add_argument("--curated-at", default="")
    p_embed.add_argument("--no-delete-first", action="store_true")
    p_embed.set_defaults(func=cmd_embed)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
