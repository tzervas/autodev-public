#!/usr/bin/env python3
"""Observe GPU plan / router state. No SSH. No placement (G6).

Records alias requests in CSD_ROUTER_STATE when CSD_GPU_PLAN is present
and valid. Never picks a host+GPU, never leases, never binds 0.0.0.0.
Fails closed when the plan file is missing.
"""

from __future__ import annotations

import argparse
import json
import os
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]


def plan_path() -> Path:
    return Path(os.environ.get("CSD_GPU_PLAN", "/fleet-data/cabal/gpu-plan.json"))


def state_path() -> Path:
    return Path(
        os.environ.get("CSD_ROUTER_STATE", "/fleet-data/cabal/model-router-state.json")
    )


def cat_path() -> Path:
    return Path(
        os.environ.get("CSD_ROUTER_CATALOG", str(ROOT / "config" / "model-router.json"))
    )


def _load_json(path: Path) -> dict[str, Any]:
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def require_plan() -> dict[str, Any]:
    path = plan_path()
    if not path.is_file():
        raise SystemExit(f"csd-model-router: missing CSD_GPU_PLAN {path} (fail closed)")
    data = _load_json(path)
    if not data or data.get("host-a") is None:
        raise SystemExit(f"csd-model-router: invalid CSD_GPU_PLAN {path} (fail closed)")
    return data


def load_state() -> dict[str, Any]:
    st = _load_json(state_path())
    st.setdefault("resident", {})
    st.setdefault("parked", {})
    st.setdefault("history", [])
    return st


def save_state(st: dict[str, Any]) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    st["history"] = (st.get("history") or [])[-40:]
    path.write_text(json.dumps(st, indent=2) + "\n", encoding="utf-8")


def catalog() -> dict[str, Any]:
    path = cat_path()
    data = _load_json(path)
    if not data:
        raise SystemExit(f"csd-model-router: missing catalog {path} (fail closed)")
    return data


def cmd_status() -> dict[str, Any]:
    plan = require_plan()
    st = load_state()
    return {
        "ok": True,
        "placement": False,
        "plan_keys": sorted(plan.keys()),
        "resident": st.get("resident") or {},
        "parked": st.get("parked") or {},
    }


def cmd_request(alias: str, why: str, ttl: int | None, noping: bool) -> dict[str, Any]:
    """Record a logical request only. Does not place or load a model."""
    require_plan()
    cat = catalog()
    spec = (cat.get("aliases") or {}).get(alias)
    if not isinstance(spec, dict):
        return {"ok": False, "error": f"unknown alias {alias}", "placement": False}
    ttl_s = int(ttl if ttl is not None else spec.get("ttl_s") or 1800)
    now = time.time()
    st = load_state()
    host_pref = spec.get("host_pref") or ["host-a"]
    host = host_pref[0] if isinstance(host_pref, list) and host_pref else "host-a"
    st["resident"][alias] = {
        "host": host,
        "until": now + ttl_s,
        "why": why,
        "noping": noping,
        "placement": False,
        "note": "observe-only; placement is G6",
    }
    st.setdefault("parked", {}).pop(alias, None)
    st.setdefault("history", []).append(
        {"t": now, "request": alias, "host": host, "placement": False, "why": why}
    )
    save_state(st)
    return {
        "ok": True,
        "alias": alias,
        "host": host,
        "ttl_s": ttl_s,
        "loaded": False,
        "placement": False,
        "noping": noping,
    }


def cmd_pack(noping: bool) -> dict[str, Any]:
    require_plan()
    cat = catalog()
    default = str(cat.get("autodev_default") or "local/code")
    actions = [cmd_request(default, "autodev-pack", None, noping=noping)]
    return {
        "ok": all(a.get("ok") for a in actions),
        "actions": actions,
        "placement": False,
    }


def cmd_restore() -> dict[str, Any]:
    require_plan()
    return {
        "ok": True,
        "actions": [],
        "placement": False,
        "note": "observe-only restore; nothing to place",
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    rq = sub.add_parser("request")
    rq.add_argument("--alias", required=True)
    rq.add_argument("--why", default="autodev")
    rq.add_argument("--ttl", type=int, default=None)
    rq.add_argument("--noping", action="store_true")
    pk = sub.add_parser("pack")
    pk.add_argument("--noping", action="store_true", default=True)
    sub.add_parser("restore")
    args = parser.parse_args(argv)

    if args.cmd == "status":
        rec = cmd_status()
    elif args.cmd == "request":
        rec = cmd_request(str(args.alias), str(args.why), args.ttl, bool(args.noping))
    elif args.cmd == "pack":
        rec = cmd_pack(noping=bool(args.noping))
    else:
        rec = cmd_restore()

    print(json.dumps(rec, indent=2))
    return 0 if rec.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
