    """Feature flag. Default off so autodev does not wake hosted Grok."""
    raw = os.environ.get("CSD_NEED_GROK", os.environ.get("CSD_NEED_GROK_ENABLED", "0"))
    return str(raw).strip().lower() in {"1", "true", "yes", "on"}


