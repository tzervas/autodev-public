#!/usr/bin/env python3
"""Monitor and steer lab GPUs + LocalAI from this machine.

Usage:
  ./scripts/csd-lab-console --http 9118  # service + dashboard (LAN bind only)
  ./scripts/csd                    # thin HTTP client (status/steer/runs/…)
  ./scripts/csd-lab-console --steer pause   # legacy flags → HTTP client

Operator CLI paths talk HTTP only (R1). --http is the service process.
Never pauses LocalAI. Never dual 14B. Never 0.0.0.0.
Never widen apply allowlist. Never wrap csd-autodev-provision.
"""

from __future__ import annotations

try:  # the loader lives in src/, which the unit puts on PYTHONPATH
    from csd_autodev import fleet as FLEET
except ImportError:  # run standalone, without src/ on the path

    class FLEET:  # type: ignore[no-redef]
        """The same resolution, without the import.

        The first version of this fallback returned the caller's default, which
        was None -- so a script run outside the unit crashed on `None + str`
        instead of using the committed defaults. A fallback that cannot do the
        job is not a fallback; it is a delayed failure.
        """

        @staticmethod
        def get(dotted, default=None):
            import json as _j
            from pathlib import Path as _P

            base = _P(__file__).resolve().parents[1] / "config"
            cfg: dict = {}
            for name in ("fleet.example.json", "fleet.json"):
                try:
                    cfg = {**cfg, **_j.loads((base / name).read_text())}
                except (OSError, ValueError):
                    continue
            node = cfg
            for part in dotted.split("."):
                if not isinstance(node, dict) or part not in node:
                    return default
                node = node[part]
            return node


