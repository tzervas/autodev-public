#!/usr/bin/env python3
"""Turn a discovered problem into a goal autodev can actually close.

WHY. Every defect this system found today was handed back to a person to write
up: the half-done goal, the stale-base sync, the tests the suite was hiding. That
is the bottleneck. A finding is only useful once it is a goal with a named file,
a stated proof and the call-chain facts the implementer needs -- and writing that
by hand is exactly the step that does not scale.

WHAT IT DOES. Takes a finding in plain words, gathers the EVIDENCE from the
repository itself (the file, the symbol, its real signature, whether a test names
it), and asks the planner to write a goal row in the house style. Then it checks
the result against the rules that goals have actually failed on here, and refuses
to queue one that breaks them.

WHAT IT REFUSES TO QUEUE, each because a goal that failed this way cost a cycle:
  - a goal naming no file, or naming a file that is not in the repo
  - a goal spanning more than one file (apply_proposal writes exactly one, so the
    half that lands passes CI and the goal closes with the rest missing)
  - a goal with no stated proof -- "add tests" is not a goal
  - a goal whose id collides with an existing row
  - a goal over 1200 characters, which is a design document, not a task

It appends to the goals file only after all of those pass. A rejected draft is
printed with the reason, for a person to fix in seconds rather than a cycle.

Usage:
    csd-autodev-intake --repo <path> --goals <GOALS.md> \\
        --finding 'validate_catalog enforces the schema but nothing tests it' \\
        [--id G-SCHEMA-2] [--dry-run]
"""

from __future__ import annotations

import argparse
import ast
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
GATEWAY_CLI = ROOT / "scripts" / "csd-gateway-complete"
MAX_GOAL = 1200


def repo_files(repo: Path) -> list[str]:
    try:
        r = subprocess.run(
            ["git", "ls-files"], cwd=str(repo), capture_output=True, text=True, timeout=60
        )
        return [f for f in r.stdout.split() if f]
    except Exception:
        return []


def evidence_for(repo: Path, finding: str, listing: list[str]) -> str:
    """The facts the goal must carry, read from the source rather than recalled.

    Goals here have failed three times for want of exactly this: one specified
    validation a function does not perform, one omitted a fixture key two calls
    down, one assumed `license_ok` returned a tuple when it returns a bool. All
    three were answerable by reading the file.
    """
    out: list[str] = []
    named = [f for f in listing if f in finding or Path(f).name in finding]
    symbols = set(re.findall(r"[`\b]([a-z_][a-z0-9_]{3,})\b", finding.lower()))

    for rel in named[:4]:
        p = repo / rel
        try:
            src = p.read_text(encoding="utf-8", errors="replace")
        except Exception:
            continue
        out.append(f"--- {rel} ({len(src.splitlines())} lines) ---")
        if rel.endswith(".py"):
            try:
                tree = ast.parse(src)
            except SyntaxError:
                continue
            for node in tree.body:
                if isinstance(node, ast.FunctionDef):
                    sig = ast.unparse(node.args) if hasattr(ast, "unparse") else ""
                    ret = (
                        ast.unparse(node.returns)
                        if getattr(node, "returns", None)
                        else "?"
                    )
                    mark = (
                        "  <-- named in the finding"
                        if node.name.lower() in symbols
                        else ""
                    )
                    out.append(f"  def {node.name}({sig}) -> {ret}{mark}")
                elif isinstance(node, ast.Assign):
                    for t in node.targets:
                        if isinstance(t, ast.Name) and t.id.isupper():
                            try:
                                val = ast.unparse(node.value)[:80]
                            except Exception:
                                val = "?"
                            out.append(f"  {t.id} = {val}")

    tests = [f for f in listing if "test" in f and f.endswith(".py")]
    if tests:
        out.append(f"--- test files: {', '.join(tests[:4])} ---")
        for rel in tests[:2]:
            try:
                body = (repo / rel).read_text(encoding="utf-8", errors="replace")
            except Exception:
                continue
            for sym in sorted(symbols):
                if sym in body:
                    out.append(f"  `{sym}` IS already named in {rel}")
    return "\n".join(out) or "(no matching file found in the repository)"


# How alike two goal texts may be before the second IS the first again.
#
# Measured on the real case -- four queued proposals to add the same function to
# the same file, against the other invalid rows:
#
#     exact repeat                1.00
#     same file, different ask    0.41 and below
#     unrelated goal              0.07
#
# so 0.82 sits in a wide gap rather than on a boundary.
DEAD_END_RATIO = 0.82


def _similar(a: str, b: str) -> float:
    """How much two goal texts are the same ask.

    The higher of a sequence ratio and a token-set overlap. The sequence ratio
    alone is length-sensitive -- a 120-character paraphrase of a 460-character
    goal scores 0.33 however plainly it is the same request -- and token overlap
    alone ignores order. Taking the larger catches a repeat by either route,
    and the measured gap is wide enough that neither produces a false positive.
    """
    import difflib

    ta, tb = set(a.split()), set(b.split())
    overlap = len(ta & tb) / len(ta | tb) if (ta | tb) else 0.0
    return max(difflib.SequenceMatcher(None, a, b).ratio(), overlap)


def dead_end(text: str, existing: str) -> str:
    """The id of an already-rejected goal this one repeats, if any.

    THE LOOP REDISCOVERS ITS OWN DEAD ENDS. Nothing compared a new proposal
    against goals already marked invalid, so the intent-gap pass queued "Change
    ONLY src/csd_client/cli.py. Add `cmd_submit` ..." four times, each one
    escalated three times and invalidated, each costing a dozen model calls to
    reach a conclusion that was already written on the row above.

    Compared against INVALID rows only. A goal that merely resembles a DONE one
    is often the legitimate next step -- "add tests for X" twice over two files
    is not a repeat -- and blocking those would stop the queue refilling.
    """

    # Strip the loop's own annotations from BOTH sides. A proposal never carries
    # them, but a stored row does, and comparing a bare ask against an ask plus
    # three hundred characters of failure notes scores low for the wrong reason.
    def bare(t: str) -> str:
        t = " ".join(t.lower().split())
        for marker in ("blocked:", "invalid because:", "rewritten:"):
            t = t.split(marker)[0]
        return t.strip()

    want = bare(text)
    if not want:
        return ""
    for line in existing.splitlines():
        cells = line.split("|")
        if len(cells) != 5 or cells[3].strip().lower() != "invalid":
            continue
        other = bare(cells[2])
        if not other:
            continue
        if _similar(want, other) >= DEAD_END_RATIO:
            return cells[1].strip()
    return ""


def free_id(gid: str, existing: str) -> str:
    """The same id with the next free number, when the proposed one is taken.

    A COLLISION IS NOT A REASON TO REFUSE. The adoption pass reported a real
    finding, the planner proposed `G-SHELLCHECK-1`, and that id was already in
    the file from an earlier round -- so the goal was rejected, adoption queued
    nothing, and the queue stayed empty with a known finding outstanding. Three
    retries produced the same id, because nothing about the retry made a
    different one more likely.

    Renumbering is mechanical and the tool can do it, which is the difference
    between a rule that protects the queue and a rule that blocks it.
    """

    def taken(candidate: str) -> bool:
        return bool(re.search(rf"\|\s*{re.escape(candidate)}\s*\|", existing, re.I))

    if not taken(gid):
        return gid
    m = re.match(r"^(.*?)-(\d+)$", gid)
    stem, n = (m.group(1), int(m.group(2))) if m else (gid, 0)
    for i in range(n + 1, n + 200):
        cand = f"{stem}-{i}"
        if not taken(cand):
            return cand
    return gid


def check(row: str, listing: list[str], existing: str) -> list[str]:
    """The rules goals have actually failed on here. Each one cost a cycle."""
    errs: list[str] = []
    # CASE-INSENSITIVE, THEN NORMALISED. The planner wrote `G-pytest-config-1`,
    # which is a perfectly good id, and this rejected it for being lowercase --
    # blocking the queue on nothing. The id only has to round-trip through
    # goal_branch()/close_goal(), which lowercase it anyway, so case carries no
    # meaning. It is upper-cased on the way in because goal_id() in the loop
    # matches uppercase, and a row that intake accepts but the loop cannot parse
    # is worse than one rejected here.
    m = re.match(r"\|\s*(G-[A-Za-z0-9-]+)\s*\|(.*)\|\s*open\s*\|\s*$", row.strip())
    if not m:
        return ["not a well-formed goal row: | G-ID | text | open |"]
    gid, text = m.group(1).upper(), m.group(2)

    if re.search(rf"\|\s*{re.escape(gid)}\s*\|", existing):
        errs.append(f"id {gid} already exists in the goals file")

    twin = dead_end(text, existing)
    if twin:
        errs.append(
            f"this repeats {twin}, which was already tried and marked invalid. "
            "Name a DIFFERENT gap, or say why this one is now achievable when "
            "it was not."
        )
    if len(row) > MAX_GOAL:
        errs.append(f"{len(row)} chars: that is a design document, not a task")

    named = sorted({f for f in listing if f in text})
    # A GOAL MAY CREATE A FILE, and a created file is not in the listing yet.
    # Requiring an existing name pushed a real finding onto the wrong file: the
    # fix was "declare .shellcheckrc", that path does not exist, so the planner
    # reached for the nearest existing file that mentions shellcheck --
    # .grok/skills/csd-autodev/SKILL.md -- and the goal would have edited
    # documentation instead of adding configuration.
    #
    # A creation is recognisable from the goal's own words, and the path still
    # has to look like a path, so this does not readmit invented names in
    # ordinary edit goals.
    creating = re.search(r"\b(create|add a new|declare)\b", text, re.I)
    if not named and creating:
        made = re.findall(r"`?((?:[\w.-]+/)*\.?[\w-]+\.[\w-]+|\.[\w-]+rc)`?", text)
        named = sorted({m for m in made if m})[:1]
    if not named:
        errs.append("names no file that exists in the repository")
    elif len(named) > 1:
        # MENTIONING A FILE IS NOT CHANGING IT. This counted every repo path
        # anywhere in the text, so a perfectly correct goal -- "add a section to
        # pyproject.toml, and prove tests/test_x.py now collects" -- was refused
        # for spanning two files when it changes one. Three planner retries all
        # failed against a rule that could not be satisfied, and the queue
        # stalled on it.
        #
        # An explicit scope sentence settles it. The planner is already told to
        # write one, so requiring it here costs nothing and makes the target
        # unambiguous for the implementer too.
        scope = re.search(r"chang\w*\s+only\s+`?([\w./-]+)`?", text, re.I)
        # rstrip the sentence's own punctuation: the path class contains `.`, so
        # "Change ONLY pyproject.toml." captures the trailing full stop and the
        # lookup misses by one character.
        target = scope.group(1).rstrip(".,;:") if scope else ""
        if target in listing:
            pass
        else:
            errs.append(
                f"names {len(named)} files ({', '.join(named)}) without saying "
                "which ONE it changes; apply_proposal writes exactly one per "
                'tick. Add "Change ONLY <path>." naming the single file to edit '
                "-- the others are evidence, not scope"
            )
    if not re.search(
        r"\b(prove|proves|proving|assert|report|reject|accept|"
        r"return|raise)\b",
        text,
        re.I,
    ):
        errs.append("states no proof; 'add tests' is not a goal")
    return errs


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--repo", required=True)
    ap.add_argument("--goals", required=True)
    ap.add_argument("--finding", required=True)
    ap.add_argument("--id", default="")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--timeout", type=int, default=300)
    a = ap.parse_args()

    repo, goals = Path(a.repo), Path(a.goals)
    if not repo.is_dir():
        print(json.dumps({"ok": False, "error": f"no repo at {repo}"}))
        return 2
    existing = goals.read_text(encoding="utf-8") if goals.is_file() else ""
    listing = repo_files(repo)
    ev = evidence_for(repo, a.finding, listing)

    prompt = f"""Write ONE goal row for an autonomous coding agent, in this exact
format and nothing else:

| G-<ID> | <the goal> | open |

THE FINDING TO TURN INTO A GOAL:
{a.finding}

EVIDENCE READ FROM THE REPOSITORY (use these facts; do not recall others):
{ev}

FILES IN THE REPOSITORY:
{chr(10).join(sorted(listing)[:120])}

RULES, each of which a previous goal broke and cost a full cycle:
- Name EXACTLY ONE file to change, and say so explicitly with the sentence
  "Change ONLY <path>." The agent writes one file per attempt, so a goal spanning
  two lands half and closes anyway. You MAY mention other files as evidence --
  "prove tests/test_x.py now collects" is fine -- but the scope sentence is what
  says which one you are editing.
- IF THE FINDING NAMES A FILE TO CREATE, that is the file to change, even though
  it is absent from the listing below. A finding reading "fix: declare
  .shellcheckrc" means `Change ONLY .shellcheckrc. Create it ...` -- NOT the
  nearest existing file that happens to mention shellcheck. Editing
  documentation about a missing config file does not create the config file, and
  a goal that cannot fix the finding is worse than no goal.
- State what must be PROVEN, not "add tests". Name the assertions.
- Carry what the call chain requires: real signatures, return SHAPES, and any
  dict key the code subscripts. `license_ok` returning a bool where the goal
  implied a tuple cost three attempts.
- Say if it CHANGES BEHAVIOUR.
- Say "Keep every existing test."
- Describe only behaviour that exists in the evidence above.
{f"- Use the id {a.id}." if a.id else "- Choose a short id like G-NAME-1."}

Output the single row and nothing else."""

    # ASK AGAIN WITH THE REASON. The planner wrote a good goal that named TWO
    # files, the one-file rule correctly refused it, and intake gave up -- so the
    # queue stalled on a rejection nobody saw. The rules are not the problem; not
    # telling the planner which one it broke is.
    #
    # Three attempts. A planner that cannot satisfy a stated rule in three tries
    # will not on the fourth, and the finding should reach a person rather than
    # burn the gateway.
    row, errs, attempts = "", ["no attempt made"], []
    for attempt in range(3):
        ask = (
            prompt
            if attempt == 0
            else (
                prompt
                + "\n\n--- YOUR PREVIOUS ROW WAS REJECTED ---\n"
                + row
                + "\n\nIt broke these rules:\n"
                + "\n".join(f"  - {e}" for e in errs)
                + "\n\nFix exactly those. Output the single corrected row and "
                "nothing else."
            )
        )
        proc = subprocess.run(
            [
                sys.executable,
                str(GATEWAY_CLI),
                "complete",
                "--kind",
                "plan",
                "--prompt",
                ask,
                "--timeout",
                str(a.timeout),
            ],
            capture_output=True,
            text=True,
            timeout=a.timeout + 60,
        )
        reply = (proc.stdout or "") + (proc.stderr or "")
        rows = [
            ln.strip()
            for ln in reply.splitlines()
            if ln.strip().startswith("| G-") and ln.strip().endswith("|")
        ]
        if not rows:
            errs = ["the reply contained no `| G-... | ... | open |` row"]
            attempts.append(f"attempt {attempt + 1}: no row")
            continue
        row = re.sub(
            r"^(\|\s*)(G-[A-Za-z0-9-]+)(\s*\|)",
            lambda m: m.group(1) + m.group(2).upper() + m.group(3),
            rows[-1],
        )
        # RENUMBER RATHER THAN REFUSE. A taken id is not a defect in the goal,
        # and rejecting one left the queue empty with a known finding
        # outstanding: adoption proposed G-SHELLCHECK-1, that id was already in
        # the file from an earlier round, and three retries produced the same id
        # because nothing about a retry makes a different one more likely.
        m_id = re.match(r"^\|\s*(G-[A-Z0-9-]+)\s*\|", row)
        if m_id and re.search(rf"\|\s*{re.escape(m_id.group(1))}\s*\|", existing, re.I):
            row = row.replace(m_id.group(1), free_id(m_id.group(1), existing), 1)
        errs = check(row, listing, existing)
        if not errs:
            break
        attempts.append(f"attempt {attempt + 1}: {'; '.join(errs)}")

    rec = {
        "ok": not errs,
        "row": row,
        "problems": errs,
        "attempts": attempts,
        "queued": False,
    }
    if errs:
        print(json.dumps(rec, indent=2))
        return 1
    if not a.dry_run:
        body = existing.rstrip("\n")
        goals.write_text(body + "\n" + row + "\n", encoding="utf-8")
        rec["queued"] = True
    print(json.dumps(rec, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
