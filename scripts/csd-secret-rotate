#!/usr/bin/env bash
# Rotate the CSD vault age identity and wrap ONE passphrase backup.
#
# Run on a real TTY (your bash, not a logged agent session):
#   bash /home/operator/code/personal/tzervas/csd-autodev/scripts/csd-secret-rotate
#
# Never pass the passphrase as argv. Never print AGE-SECRET-KEY or tokens.
# Uses `secret` / sops rewrap so .enc plaintext never hits the filesystem.
set -euo pipefail

VAULT="${CSD_VAULT:-/fleet-data/cabal/csd-vault}"
LIVE="${SOPS_AGE_KEY_FILE_CSD:-$VAULT/age.txt}"
SECRET_BIN="${CSD_SECRET_BIN:-$HOME/.local/bin/secret}"
BACKUP_DIR="${CSD_AGE_BACKUP_DIR:-$HOME/.secret-backups}"
BACKUP="$BACKUP_DIR/csd-vault-age.pass.age"
PROVISION="${CSD_PROVISION:-/home/operator/code/personal/tzervas/CogSynDelta/scripts/csd-autodev-provision}"

die() { echo "csd-secret-rotate: $*" >&2; exit 1; }

[ -t 0 ] || die "stdin is not a TTY — run this in your terminal, not a pipe"
[ -r /dev/tty ] || die "no /dev/tty — refuse (passphrase would leak)"
[ -x "$SECRET_BIN" ] || die "missing $SECRET_BIN"
[ -d "$VAULT" ] || die "missing vault $VAULT"
[ -r "$LIVE" ] || die "missing live age identity $LIVE"
command -v age-keygen >/dev/null || die "age-keygen not installed"
command -v age >/dev/null || die "age not installed"
command -v sops >/dev/null || die "sops not installed"
command -v shred >/dev/null || die "shred not installed"

echo "This will:" >&2
echo "  1. Generate a NEW CSD age identity" >&2
echo "  2. Rewrap every $VAULT/*.enc to the new recipient (sops updatekeys)" >&2
echo "  3. Prompt ONCE for a passphrase you know; write ONE backup:" >&2
echo "       $BACKUP" >&2
echo "  4. Replace $LIVE (mode 600) and shred the old identity" >&2
echo "  5. Remint git/autodev into the vault (value never printed)" >&2
echo "Passphrase is not echoed, not stored, not logged." >&2
printf 'Type YES to continue: ' >&2
read -r ans </dev/tty
[ "$ans" = "YES" ] || die "aborted"

tmp="$(mktemp -d /dev/shm/csd-age-XXXXXX 2>/dev/null || mktemp -d)"
chmod 700 "$tmp"
cleanup() {
  if [ -d "$tmp" ]; then
    find "$tmp" -type f -exec shred -u {} \; 2>/dev/null || true
    rm -rf "$tmp"
  fi
  unset pass pass2
}
trap cleanup EXIT

new="$tmp/age.txt"
age-keygen -o "$new" >/dev/null
chmod 600 "$new"
newpub="$(age-keygen -y "$new")"
case "$newpub" in age1*) : ;; *) die "age-keygen -y did not return a recipient" ;; esac

oldpub="$(age-keygen -y "$LIVE")"
yaml="$VAULT/.sops.yaml"
cp -p "$yaml" "$yaml.bak-rotate"

# Widen to old+new, rewrap, then drop old.
python3 - "$yaml" "$oldpub" "$newpub" <<'PY'
import sys
from pathlib import Path
p, old, new = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = p.read_text(encoding="utf-8")
if new not in text:
    text = text.replace(old, f"{old},{new}") if old in text else text.replace(
        "age:", f"age: {new}", 1
    )
p.write_text(text, encoding="utf-8")
PY

export SOPS_AGE_KEY_FILE="$LIVE"
n=0
while IFS= read -r f; do
  rel="${f#"$VAULT"/}"
  (cd "$VAULT" && sops updatekeys --yes "$rel") >/dev/null
  n=$((n + 1))
done < <(find "$VAULT" -name '*.enc' -type f)
echo "csd-secret-rotate: rewrapped $n secret(s) onto old+new" >&2

python3 - "$yaml" "$oldpub" "$newpub" <<'PY'
import sys
from pathlib import Path
p, old, new = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
text = p.read_text(encoding="utf-8")
text = text.replace(f"{old},", "").replace(f",{old}", "").replace(old, new)
p.write_text(text, encoding="utf-8")
PY

export SOPS_AGE_KEY_FILE="$new"
n=0
while IFS= read -r f; do
  rel="${f#"$VAULT"/}"
  (cd "$VAULT" && sops updatekeys --yes "$rel") >/dev/null
  n=$((n + 1))
done < <(find "$VAULT" -name '*.enc' -type f)
echo "csd-secret-rotate: dropped old recipient; $n secret(s) on new identity only" >&2

mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"
[ ! -e "$BACKUP" ] || die "backup already exists: $BACKUP (refuse overwrite)"

umask 077
echo "age will prompt TWICE for a passphrase only you know (hidden)." >&2
echo "That passphrase is never stored. Backup path: $BACKUP" >&2
age -e -p -o "$BACKUP" "$new" </dev/tty
[ -s "$BACKUP" ] || die "passphrase wrap produced empty backup"
chmod 600 "$BACKUP"

# Install new live identity, shred old.
oldcopy="$tmp/old-age"
cp -p "$LIVE" "$oldcopy"
cp -p "$new" "$LIVE"
chmod 600 "$LIVE"
shred -u "$oldcopy"
echo "csd-secret-rotate: live identity replaced; old identity shredded from tmp" >&2

# Rotate git/autodev (Forgejo). Admin token from operator vault, never printed.
if [ -x "$PROVISION" ]; then
  echo "csd-secret-rotate: reminting git/autodev via provision (no token print)" >&2
  secret exec TOKEN=git/cabal-forgejo-admin -- python3 "$PROVISION" || \
    echo "csd-secret-rotate: WARN provision failed — remint later" >&2
fi

echo "csd-secret-rotate: done" >&2
echo "  live:   $LIVE (mode 600, for systemd secret exec)" >&2
echo "  backup: $BACKUP (passphrase-encrypted, the only backup)" >&2
echo "Next: disable git credential.store, shred ~/.git-credentials AFTER you" >&2
echo "rotate Forgejo/GitHub/HF tokens those lines held, shred leftover" >&2
echo "plaintext /fleet-data/cabal/csd-apply.token once lab uses vault env." >&2
