#!/usr/bin/env python3
"""Self-hosted autodev tick: 3090 local/code, no hosted Grok.

Pick next_goal from CSD_STEER / PHASE-1, implement via LocalAI queue,
land with csd-autodev-git + csd-autodev-forgejo, merge-gate only when
required checks ran. Never poll hosted Grok. Ping mailbox on stall.

  ./scripts/csd-autodev-loop --once
  ./scripts/csd-autodev-loop --worker
"""

