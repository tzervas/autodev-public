# Ollama, as the llama.cpp/GGUF leg -- the candidate replacement for LocalAI.
#
# THE DECISION THIS UNIT DOES NOT MAKE, and you must. Ollama has its OWN
# residency scheduler: OLLAMA_KEEP_ALIVE decides how long a model stays
# resident, and it will load and evict on its own judgement. config/
# model-router.json's `aliases.*.ttl_s` and scripts/fleet-gpu-mode decide the
# same thing. TWO SCHEDULERS ON ONE CARD is worse than either alone -- they
# will evict each other's models and each will be correct.
#
# So either Ollama owns residency on this card and the router stops deciding,
# or KEEP_ALIVE is pinned (-1 = never unload) and the router keeps control.
# The default below takes the SECOND, because preempt_autodev: false means
# nothing if something else can evict the implementer's weights.
#
# ALSO: Ollama does not serve bitnet-1.58. It cannot be the whole llama.cpp
# leg once b1.58 lands; bitnet-cpp stays a separate runtime.
[Unit]
Description=Ollama
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/ollama/ollama:vX.Y.Z   # PIN TO A DIGEST
ContainerName=ollama
Network=autodev.network
PublishPort=203.0.113.10:11434:11434
Volume=ollama.volume:/root/.ollama:Z

# CDI, the current standard for GPU passthrough under podman -- not the legacy
# --gpus flag. Generated by `nvidia-ctk cdi generate`; if /etc/cdi/nvidia.yaml
# is unreadable by the service account, generate into its own namespace.
AddDevice=nvidia.com/gpu=all

Environment=OLLAMA_HOST=0.0.0.0:11434
# -1 = never auto-unload. See the block above: this is what hands residency
# back to the router. Set a duration ONLY if Ollama is to own the card.
Environment=OLLAMA_KEEP_ALIVE=-1
# One model resident at a time on a card the implementer holds exclusively.
Environment=OLLAMA_MAX_LOADED_MODELS=1

HealthCmd=curl -fsS http://localhost:11434/api/tags || exit 1
HealthInterval=15s
HealthStartPeriod=60s

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
